# Backend origin used by the /api/v1 proxy in next.config (server-side only)
BACKEND_URL=https://cantox-backend-production.up.railway.app

# Leave empty when using the proxy above (recommended: cookies stay first-party).
# Only set this to call the backend directly, e.g. https://api.cantox.com
NEXT_PUBLIC_API_URL=https://cantox-backend-production.up.railway.app
