# Backend origin used by the /api/v1 proxy in next.config (server-side only)
BACKEND_URL=https://cantox-backend.onrender.com

# Leave empty when using the proxy above (recommended: cookies stay first-party).
# Only set this to call the backend directly, e.g. https://api.cantox.com
NEXT_PUBLIC_API_URL=https://cantox-backend.onrender.com

# Logo request emails via RavenRelay (server-side only — never prefix with NEXT_PUBLIC_)
# Use an rr_test_ key while developing (simulated, nothing delivered); rr_live_ in production.
RAVENRELAY_API_KEY=rr_test_xxxxxxxxxxxx
# Sender — must be on a domain verified in RavenRelay for live keys
LOGO_REQUEST_FROM=CantoX <hello@cantox.com>
# Where new requests land (comma-separate multiple inboxes)
LOGO_REQUEST_TO=design@cantox.com
